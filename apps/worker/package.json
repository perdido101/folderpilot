{
  "name": "@folderpilot/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run --passWithNoTests .unit.test.ts",
    "test:integration": "vitest run .int.test.ts"
  },
  "dependencies": {
    "@folderpilot/adapters": "workspace:*",
    "@folderpilot/ai": "workspace:*",
    "@folderpilot/analysis": "workspace:*",
    "@folderpilot/core": "workspace:*",
    "@folderpilot/db": "workspace:*",
    "bullmq": "^5.61.0",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^5.8.2",
    "pdfjs-dist": "^4.10.38",
    "pino": "^10.1.0",
    "sharp": "^0.35.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
