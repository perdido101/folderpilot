# FolderPilot configuration. Copy to .env (or run `pnpm setup:env`, which also generates the secrets).
# Only the "Required" group is needed to run locally; every external account is optional —
# its feature stays hidden ("not configured") until you fill it in. Step-by-step: docs/SETUP.md

# ── Required ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://folderpilot:folderpilot@localhost:5432/folderpilot   # Postgres 16 + pgvector (pnpm services:up)
REDIS_URL=redis://localhost:6379                                              # Redis 7 (BullMQ queues, rate limits)
APP_URL=http://localhost:5173                                                 # where the web app is served
API_URL=http://localhost:3000                                                 # where this API is served (OAuth callbacks use it)
# 32+ random bytes. `pnpm setup:env` fills these in. Changing ENCRYPTION_KEY makes stored tokens unreadable.
BETTER_AUTH_SECRET=
ENCRYPTION_KEY=

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3000
LOG_LEVEL=info                      # fatal | error | warn | info | debug | trace | silent
WORKER_HEARTBEAT_MS=60000

# ── Sign in with Google + Google Drive (Connect mode) — docs/SETUP.md#google ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Sign in with Microsoft + OneDrive/SharePoint — docs/SETUP.md#microsoft ────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common             # "common", "organizations", or your tenant id

# ── Dropbox (Connect mode) — docs/SETUP.md#dropbox ───────────────────────────
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# ── FolderPilot Cloud storage: any S3-compatible bucket (R2, B2, Hetzner) — docs/SETUP.md#storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET=
S3_REGION=auto

# ── FolderPilot AI (hosted default, Anthropic) — docs/SETUP.md#anthropic ─────
ANTHROPIC_API_KEY=
FP_AI_ANALYSIS_MODEL=claude-haiku-5-5   # small, fast model for file analysis
FP_AI_AGENT_MODEL=claude-opus-5-5       # stronger model for the agent

# ── Local AI (Private mode) — docs/SETUP.md#ollama ───────────────────────────
OLLAMA_URL=                             # e.g. http://localhost:11434
# Embedding model on OLLAMA_URL for search by meaning when an organization's AI can't embed
# (FolderPilot AI, Claude/Bedrock/Vertex). At most 1024 dimensions. Empty = nomic-embed-text.
FP_EMBED_MODEL=

# ── Billing (Stripe) — docs/SETUP.md#stripe ──────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PERSONAL=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_CONNECT=
STRIPE_PRICE_STORAGE_OVERAGE=

# ── Upload virus scanning (Cloud mode) — docs/SETUP.md#clamav ────────────────
CLAMAV_HOST=                            # e.g. localhost:3310

# ── MCP server over HTTP (Cloud/Connect) — Phase 10 ──────────────────────────
MCP_PUBLIC_URL=

# ---- Development ----
# A folder on this machine shown to the seeded "Demo Office" as a read-only "Sample files (dev)" space,
# so the server pipeline (worker analysis + AI) can be tried before Cloud/Connect/Private modes exist.
# Create one with `pnpm sample`, set the absolute path, then run `pnpm db:seed`. Ignored in production.
FP_DEV_SAMPLE_DIR=
# BullMQ key prefix; the API and worker must use the same one (tests use their own).
FP_QUEUE_PREFIX=bull

# ── Tests ──────────────────────────────────────────────────────────────────────
# Integration tests create and drop throwaway databases using this connection.
TEST_DATABASE_URL=postgres://folderpilot:folderpilot@localhost:5432/folderpilot

# ── Web build ──────────────────────────────────────────────────────────────────
# VITE_LOCAL_ONLY=1 builds a device-only web app (no server, no accounts) — used for GitHub Pages.
VITE_LOCAL_ONLY=
