{
  "name": "folderpilot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel --filter=@folderpilot/web --filter=@folderpilot/server --filter=@folderpilot/worker",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "test:e2e": "pnpm --filter @folderpilot/e2e e2e",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @folderpilot/db generate",
    "db:migrate": "pnpm --filter @folderpilot/db migrate",
    "db:seed": "pnpm --filter @folderpilot/server seed",
    "services:up": "docker compose -f deploy/docker-compose.dev.yml up -d --wait",
    "services:down": "docker compose -f deploy/docker-compose.dev.yml down",
    "sample": "tsx scripts/make-sample-folder.ts",
    "setup:env": "tsx scripts/setup-env.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "jpeg-js": "^0.4.4",
    "jszip": "^3.10.2",
    "prettier": "^3.6.2",
    "tsx": "^4.23.15",
    "turbo": "^2.11.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.7"
  }
}
